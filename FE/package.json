{
  "name": "friday-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24.22.1 || ^26.0.0",
    "npm": ">=11 <13"
  },
  "packageManager": "npm@11.4.1",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@fontsource/lexend": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@hookform/resolvers": "7.0.9",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-navigation-menu": "1.4.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-table": "9.3.1",
    "@xyflow/react": "13.0.3",
    "axios": "1.21.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.83.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-router": "8.5.3",
    "recharts": "3.11.2",
    "sonner": "2.0.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "8.1.3",
    "@babel/eslint-parser": "8.1.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.4",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.4.0",
    "vitest": "5.1.2"
